# ==========================================
# VARIABLES DE ENTORNO - GESTOR DE ARTÍCULOS
# ==========================================

# Servidor Backend
PORT=3000
NODE_ENV=development

# Base de Datos (MongoDB Atlas o Local Docker)
MONGO_URI=mongodb://root:secret@localhost:27017/gestor_articulos?authSource=admin
MONGO_DB_NAME=gestor_articulos

# Autenticación Better Auth (Generar un string secreto aleatorio en prod)
BETTER_AUTH_SECRET=super-secret-key-for-dev-testing-12345
BETTER_AUTH_URL=http://localhost:3000

# Frontend API URL
VITE_API_URL=http://localhost:3000/api
